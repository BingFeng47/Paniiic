{
  "name": "kiroween",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "art:list": "ART_LIST_WRITE=1 vitest run tests/docs/artList.test.ts",
    "sim:build": "vite build --config tools/mcp-sim/vite.config.ts",
    "sim:check": "npm run sim:build && node tools/mcp-sim/dist/check.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@vitest/coverage-v8": "^5.1.1",
    "fast-check": "^4.10.3",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@fontsource/vt323": "^5.3.0"
  }
}
